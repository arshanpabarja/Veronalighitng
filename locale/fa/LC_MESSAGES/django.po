#: .\templates\company\about.html:179
msgid "High Efficiency"
msgstr "بازدهی بالا"

#: .\templates\company\about.html:180
msgid "Luminous Efficacy Focus"
msgstr "تمرکز بر بهره‌وری نوری"

#: .\templates\company\about.html:181
msgid ""
"Next-generation diode systems built to reduce overall structural wattage "
